{
  "name": "ymdesk",
  "version": "1.0.0",
  "description": "Полноценный десктоп-клиент Яндекс Музыки (Electron + React)",
  "main": "electron/main.js",
  "author": "ymdesk",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c green,blue \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.ymdesk.app",
    "productName": "YM Desk",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": { "category": "public.app-category.music" },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": "AppImage", "category": "Audio" }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  }
}
